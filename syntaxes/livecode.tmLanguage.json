{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LiveCode Script",
  "scopeName": "source.livecode",
  "fileTypes": ["livecodescript", "livecode", "irev", "rev"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#handler-definitions" },
    { "include": "#control-flow" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#chunk-expressions" },
    { "include": "#builtin-functions" },
    { "include": "#properties" },
    { "include": "#object-references" },
    { "include": "#numbers" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.livecode",
          "match": "--.*$"
        },
        {
          "name": "comment.line.hash.livecode",
          "match": "#.*$"
        },
        {
          "name": "comment.block.livecode",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.livecode" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.livecode",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.livecode",
          "match": "\\\\."
        }
      ]
    },
    "handler-definitions": {
      "patterns": [
        {
          "comment": "on/before/after message handlers",
          "match": "(?i)^\\s*(private\\s+)?(on|before|after)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(.*)$",
          "captures": {
            "1": { "name": "storage.modifier.livecode" },
            "2": { "name": "storage.type.handler.livecode" },
            "3": { "name": "entity.name.function.livecode" },
            "4": { "name": "variable.parameter.livecode" }
          }
        },
        {
          "comment": "function handlers",
          "match": "(?i)^\\s*(private\\s+)?(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(.*)$",
          "captures": {
            "1": { "name": "storage.modifier.livecode" },
            "2": { "name": "storage.type.function.livecode" },
            "3": { "name": "entity.name.function.livecode" },
            "4": { "name": "variable.parameter.livecode" }
          }
        },
        {
          "comment": "getprop/setprop handlers",
          "match": "(?i)^\\s*(getprop|setprop)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(.*)$",
          "captures": {
            "1": { "name": "storage.type.handler.livecode" },
            "2": { "name": "entity.name.function.livecode" },
            "3": { "name": "variable.parameter.livecode" }
          }
        },
        {
          "comment": "end handler",
          "match": "(?i)^\\s*(end)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*$",
          "captures": {
            "1": { "name": "storage.type.handler.livecode" },
            "2": { "name": "entity.name.function.livecode" }
          }
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "comment": "if/then/else/end if",
          "match": "(?i)\\b(if|then|else|end\\s+if)\\b",
          "name": "keyword.control.conditional.livecode"
        },
        {
          "comment": "repeat loops",
          "match": "(?i)\\b(repeat|end\\s+repeat|exit\\s+repeat|next\\s+repeat)\\b",
          "name": "keyword.control.loop.livecode"
        },
        {
          "comment": "repeat qualifiers",
          "match": "(?i)\\b(forever|for|times|while|until|with|from|to|by|down\\s+to)\\b",
          "name": "keyword.control.loop.qualifier.livecode"
        },
        {
          "comment": "try/catch/finally/throw",
          "match": "(?i)\\b(try|catch|finally|throw|end\\s+try)\\b",
          "name": "keyword.control.exception.livecode"
        },
        {
          "comment": "switch/case/default/break",
          "match": "(?i)\\b(switch|case|default|break|end\\s+switch)\\b",
          "name": "keyword.control.switch.livecode"
        },
        {
          "comment": "exit/pass/return",
          "match": "(?i)\\b(exit|pass|return)\\b",
          "name": "keyword.control.flow.livecode"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "put/into/before/after - the core assignment operator",
          "match": "(?i)\\b(put|into|before|after|get|set|let)\\b",
          "name": "keyword.operator.assignment.livecode"
        },
        {
          "comment": "message sending",
          "match": "(?i)\\b(send|dispatch|call|do|value)\\b",
          "name": "keyword.other.message.livecode"
        },
        {
          "comment": "variable declaration",
          "match": "(?i)\\b(local|global|constant)\\b",
          "name": "storage.modifier.livecode"
        },
        {
          "comment": "common commands",
          "match": "(?i)\\b(add|subtract|multiply|divide|answer|ask|answer\\s+file|ask\\s+file|open|close|read|write|seek|delete|create|copy|move|rename|launch|beep|wait|lock|unlock|show|hide|enable|disable|focus|select|click|drag|type|key|play|stop|record|start|go|push|pop|mark|unmark|sort|filter|replace|find|load|unload|import|export|print|open\\s+printing|close\\s+printing|cancel\\s+printing|group|ungroup|choose|grab|rotate|flip|resize|revoke|grant|request|reply|accept)\\b",
          "name": "keyword.other.command.livecode"
        },
        {
          "comment": "image and visual commands",
          "match": "(?i)\\b(visual|effect|dissolve|zoom|wipe|iris|barn|push|scroll|stretch|reveal|venetian|checkerboard|flash|camera|plain|fast|slow|slowly|very|left|right|up|down|open|close|in|out|top|bottom|center|middle|black|white|gray|inverse)\\b",
          "name": "keyword.other.visual.livecode"
        },
        {
          "comment": "the keyword (property access)",
          "match": "(?i)\\bthe\\b",
          "name": "keyword.other.the.livecode"
        },
        {
          "comment": "of/in/from/to/with/without/into/onto/at/as",
          "match": "(?i)\\b(of|in|from|to|with|without|onto|at|as|on|against|is|are|was|were|not|and|or|xor|div|mod|contains|is\\s+in|is\\s+not|is\\s+a|is\\s+not\\s+a|there\\s+is\\s+(a|an|no)|there\\s+are|me|my|its|this|it|the\\s+result|the\\s+error)\\b",
          "name": "keyword.other.livecode"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.livecode",
          "match": "(<=|>=|<>|=|<|>|≤|≥|≠)"
        },
        {
          "name": "keyword.operator.arithmetic.livecode",
          "match": "(\\+|-|\\*|/|\\^|&&|&)"
        },
        {
          "name": "keyword.operator.concat.livecode",
          "comment": "& is string concat, && is concat with space",
          "match": "&&?"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "comment": "boolean constants",
          "match": "(?i)\\b(true|false)\\b",
          "name": "constant.language.boolean.livecode"
        },
        {
          "comment": "null/empty",
          "match": "(?i)\\b(empty|nothing|undefined|null)\\b",
          "name": "constant.language.null.livecode"
        },
        {
          "comment": "text constants",
          "match": "(?i)\\b(return|cr|lf|crlf|linefeed|tab|space|quote|comma|colon|slash|backslash|pi|zero|one|two|three|four|five|six|seven|eight|nine|ten|formfeed|numtochar|chartonum)\\b",
          "name": "constant.language.text.livecode"
        },
        {
          "comment": "up/down/left/right as directional constants",
          "match": "(?i)\\b(up|down|left|right|center|middle)\\b",
          "name": "constant.language.direction.livecode"
        }
      ]
    },
    "chunk-expressions": {
      "patterns": [
        {
          "comment": "chunk type keywords",
          "match": "(?i)\\b(char|character|characters|word|words|line|lines|item|items|sentence|sentences|paragraph|paragraphs|token|tokens|byte|bytes|segment|segments|row|rows|column|columns|first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth|last|middle|any|each|every)\\b",
          "name": "keyword.other.chunk.livecode"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "comment": "math functions",
          "match": "(?i)\\b(abs|average|avg|max|min|sum|round|trunc|sqrt|sin|cos|tan|atan|atan2|exp|exp1|exp2|log|log2|log10|ln|ln1|random|baseconvert|binaryencode|binarydecode|byteoffset|charoffset|wordoffset|lineoffset|itemoffset|offset)\\b",
          "name": "support.function.math.livecode"
        },
        {
          "comment": "string functions",
          "match": "(?i)\\b(length|len|upper|lower|toUpper|toLower|format|value|numtochar|chartonum|numtobyte|bytetonum|merge|matchtext|matchchunk|replacetext|filter|sort|keys|extents|transpose|is\\s+a\\s+(number|integer|real|boolean|point|rect|color|date|time|url|strict\\s+date|strict\\s+time|strict\\s+url))\\b",
          "name": "support.function.string.livecode"
        },
        {
          "comment": "date and time functions",
          "match": "(?i)\\b(the\\s+)?(date|time|seconds|ticks|milliseconds|long\\s+date|long\\s+time|short\\s+date|short\\s+time|abbreviated\\s+date|abbreviated\\s+time|dateitems|secs|msecs|convert)\\b",
          "name": "support.function.date.livecode"
        },
        {
          "comment": "file and URL functions",
          "match": "(?i)\\b(url|file|binfile|resfile|ftp|http|https|the\\s+files|the\\s+folders|the\\s+directory|specialFolderPath|tempName|longFilePath|shortFilePath|exists|is\\s+a\\s+file|is\\s+a\\s+folder)\\b",
          "name": "support.function.file.livecode"
        },
        {
          "comment": "type checking",
          "match": "(?i)\\b(isNumber|isInteger|isDate|isTime|isColor|isPoint|isRect|isUrl)\\b",
          "name": "support.function.type.livecode"
        },
        {
          "comment": "crypto and encoding",
          "match": "(?i)\\b(md5digest|sha1digest|sha256digest|sha512digest|base64encode|base64decode|urlencode|urldecode|decompress|compress|encrypt|decrypt|random|uuid|crc32)\\b",
          "name": "support.function.crypto.livecode"
        },
        {
          "comment": "array functions",
          "match": "(?i)\\b(keys|values|extents|transpose|is\\s+an\\s+array|arrayencode|arraydecode|split|combine|union|intersect)\\b",
          "name": "support.function.array.livecode"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "comment": "common object properties",
          "match": "(?i)\\b(name|id|number|long\\s+name|short\\s+name|abbreviated\\s+name|rect|rectangle|location|loc|width|height|top|left|bottom|right|topLeft|bottomRight|visible|enabled|disabled|selected|hilite|hilited|style|textFont|textSize|textStyle|textColor|foreColor|backColor|backgroundColor|foregroundColor|borderColor|hiliteColor|shadowColor|shadowOffset|label|text|htmltext|htmlText|rtftext|unicodeText|formattedText|script|properties|customProperties|customPropertySets|thename|theID)\\b",
          "name": "support.other.property.livecode"
        },
        {
          "comment": "stack/card properties",
          "match": "(?i)\\b(stack|stacks|card|cards|background|backgrounds|group|groups|button|buttons|field|fields|image|images|graphic|graphics|scrollbar|scrollbars|player|players|object|objects|current\\s+card|this\\s+card|recent\\s+card)\\b",
          "name": "support.other.object.livecode"
        }
      ]
    },
    "object-references": {
      "patterns": [
        {
          "comment": "object reference keywords",
          "match": "(?i)\\b(this\\s+stack|this\\s+card|this|me|target|sender|owner|parent|topStack|focusedObject|selectedObject|selectedImage|clickedObject|dragSource|dragDestination|mouseControl|hoveredControl|touchedControl|foundChunk|foundField|foundLine|foundText|the\\s+message|the\\s+params|the\\s+paramCount|param|params|paramCount|the\\s+result|the\\s+error|result|error)\\b",
          "name": "variable.language.builtin.livecode"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.livecode",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.livecode",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.livecode",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "comment": "tVariable convention (local), sVariable (script-local), gVariable (global), pParam",
          "match": "\\b([tsgpTSGP][A-Z][a-zA-Z0-9_]*)\\b",
          "name": "variable.other.livecode"
        }
      ]
    }
  }
}
