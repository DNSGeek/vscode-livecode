{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LiveCode Builder",
  "scopeName": "source.livecodebuilder",
  "fileTypes": ["lcb"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#module-declarations" },
    { "include": "#handler-definitions" },
    { "include": "#control-flow" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.livecodebuilder",
          "match": "--.*$"
        },
        {
          "name": "comment.block.livecodebuilder",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.livecodebuilder" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.livecodebuilder",
      "begin": "\"",
      "end": "\""
    },
    "module-declarations": {
      "patterns": [
        {
          "match": "(?i)^\\s*(module|library|widget|end\\s+module|end\\s+library|end\\s+widget)\\s+([a-zA-Z_.][a-zA-Z0-9_.]*)\\s*$",
          "captures": {
            "1": { "name": "storage.type.module.livecodebuilder" },
            "2": { "name": "entity.name.type.module.livecodebuilder" }
          }
        },
        {
          "match": "(?i)^\\s*(use|metadata|property|event)\\b",
          "name": "keyword.other.module.livecodebuilder"
        },
        {
          "match": "(?i)^\\s*(foreign\\s+handler|unsafe\\s+handler)\\b",
          "name": "storage.type.handler.foreign.livecodebuilder"
        }
      ]
    },
    "handler-definitions": {
      "patterns": [
        {
          "match": "(?i)^\\s*(public\\s+|private\\s+)?(handler|function|on)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\(.*\\))?",
          "captures": {
            "1": { "name": "storage.modifier.livecodebuilder" },
            "2": { "name": "storage.type.handler.livecodebuilder" },
            "3": { "name": "entity.name.function.livecodebuilder" },
            "4": { "name": "variable.parameter.livecodebuilder" }
          }
        },
        {
          "match": "(?i)^\\s*(end)\\s+(handler|function|on)\\b",
          "captures": {
            "1": { "name": "storage.type.handler.livecodebuilder" },
            "2": { "name": "storage.type.handler.livecodebuilder" }
          }
        },
        {
          "match": "(?i)\\b(variable|constant)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.livecodebuilder" },
            "2": { "name": "variable.other.livecodebuilder" }
          }
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "match": "(?i)\\b(if|then|else|end\\s+if)\\b",
          "name": "keyword.control.conditional.livecodebuilder"
        },
        {
          "match": "(?i)\\b(repeat|end\\s+repeat|exit\\s+repeat|next\\s+repeat|forever|for|while|until|with|from|to|by|times)\\b",
          "name": "keyword.control.loop.livecodebuilder"
        },
        {
          "match": "(?i)\\b(return|throw|log)\\b",
          "name": "keyword.control.flow.livecodebuilder"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "(?i)\\b(Boolean|Integer|Real|Number|String|Data|Array|List|Pointer|any|nothing|optional)\\b",
          "name": "storage.type.builtin.livecodebuilder"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?i)\\b(put|into|get|set|as|is|not|and|or|in)\\b",
          "name": "keyword.other.livecodebuilder"
        },
        {
          "match": "(?i)\\b(true|false|nothing|empty)\\b",
          "name": "constant.language.livecodebuilder"
        },
        {
          "name": "keyword.operator.livecodebuilder",
          "match": "(<=|>=|<>|=|<|>|\\+|-|\\*|/|\\^|&&|&)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.livecodebuilder",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.livecodebuilder",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.livecodebuilder",
          "match": "\\b[0-9]+\\b"
        }
      ]
    }
  }
}
