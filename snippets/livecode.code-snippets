  },
  "Dispatch message": {
    "prefix": "dispatch",
    "body": "dispatch \"${1:message}\" to ${2:target} with ${3:params}",
    "description": "Dispatch a message"
  },
  "Set property": {
    "prefix": "set",
    "body": "set the ${1:property} of ${2:object} to ${3:value}",
    "description": "Set an object property"
  },
  "Custom property block": {
    "prefix": "custprop",
    "body": [
      "getProp ${1:myProp}",
      "\treturn the cData[\"${1:myProp}\"] of me",
      "end ${1:myProp}",
      "",
      "setProp ${1:myProp} pValue",
      "\tset the cData[\"${1:myProp}\"] of me to pValue",
      "end ${1:myProp}"
    ],
    "description": "Custom property get/set pair using cData array"
  },
