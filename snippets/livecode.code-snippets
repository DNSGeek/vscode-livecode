  "Switch/case": {
    "prefix": "switch",
    "body": [
      "switch ${1:tValue}",
      "\tcase ${2:value1}",
      "\t\t${0}",
      "\t\tbreak",
      "\tcase ${3:value2}",
      "\t\t",
      "\t\tbreak",
      "\tdefault",
      "\t\t",
      "end switch"
    ],
    "description": "Switch/case block"
  },
  "Try/catch": {
    "prefix": "try",
    "body": [
      "try",
      "\t${0}",
